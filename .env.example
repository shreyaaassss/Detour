# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini   # the model that reads typed reports
# DETOUR_LLM=off           # keep typed reports on the local rule-based reader
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Demo phone numbers (E.164, e.g. +91XXXXXXXXXX). Teammates must consent.
PHONE_STRANDED_DRIVER=
PHONE_HEAD=
PHONE_RESCUE_DRIVER=

# Public HTTPS URL from the tunnel (cloudflared), used for webhooks
PUBLIC_BASE_URL=

# Rescue timers in seconds (optional; the defaults are the PRD's values, and the push timeout must stay 60)
# DETOUR_PUSH_TIMEOUT=60
# DETOUR_DRIVER_CONFIRM=30
# DETOUR_HEAD_RESPONSE=120
# DETOUR_RING_TIMEOUT=25
# DETOUR_CONVERSATION_LIMIT=45

# Voice (optional; the key is enough). DETOUR_VOICE=off keeps phones on their own built-in voice.
# DETOUR_VOICE=off
# ELEVENLABS_VOICE_ID=         # default is the premade voice "Alice"
# ELEVENLABS_VOICE_HI=
# ELEVENLABS_VOICE_MR=
# DETOUR_VOICE_BUDGET=20000    # most characters this run may send for speech

# The escalation phone call (see docs/CALLS.md). Off unless DETOUR_CALLS=on.
# DETOUR_CALLS=on
# ELEVENLABS_PHONE_NUMBER_ID=   # the Twilio number you connected inside ElevenLabs
# PHONE_RESCUE_DRIVER=+91...    # the demo phone that receives the call (plus sign, country code, no spaces)
# PHONE_MEERA=+91...            # or one number per driver, PHONE_<NAME>
# DETOUR_CALL_LANGUAGE=hi       # hi, mr, en, or driver
# DETOUR_MAX_CALLS=6
# PUBLIC_BASE_URL=https://...   # your tunnel's address, so the agent can report its answer

# Twilio, only to connect a phone line to ElevenLabs (docs/CALLS.md). Prefer a limited API key over the Auth Token.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_API_KEY_SID=SK...
# TWILIO_API_KEY_SECRET=...
# TWILIO_AUTH_TOKEN=...          # only if you cannot create an API key
# TWILIO_PHONE_NUMBER=+1...      # the Twilio number the call comes FROM
